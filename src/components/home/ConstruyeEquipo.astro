---
// "Construye en equipo": muestra del constructor 3D de fichas de la plataforma de misiones
// (../antidoto, módulo de construcción). Va justo después de la sala: allá se ve la dinámica de
// bloques en persona y aquí la misma dinámica en 3D, que el equipo juega desde el celular.
//
// La obra se arma sola en un lienzo WebGL (src/lib/fichas/, arranque en src/lib/motion/fichas.ts)
// que carga después de `load` y cuando la sección se acerca. Antes, sin JS, sin WebGL o con
// movimiento reducido se ve la foto de la obra completa (npm run fichas:poster la regenera).
import { Image } from 'astro:assets';
import poster from '../../assets/fichas/obra.png';
import { t, rutas, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio.construye;
---
<section class="construye" aria-labelledby="construye-t" data-fichas>
  <div class="wrap rejilla">
    <div class="texto">
      <p class="etiqueta">{h.etiqueta}</p>
      <h2 id="construye-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
      <p class="lead">{h.lead}</p>
      <ul class="puntos">
        {h.puntos.map((p) => <li>{p}</li>)}
      </ul>
      <a class="boton boton-cian" href={`${rutas.contacto[locale]}?servicio=formaciones&oferta=equipos`} data-magnetico>{h.cotizar}</a>
    </div>

    <figure class="escenario" data-fichas-ventana>
      <Image class="poster" src={poster} alt={h.label} widths={[480, 720, 960, 1200]} sizes="(max-width: 900px) 92vw, 600px" loading="lazy" decoding="async" data-fichas-poster />
      <canvas class="lienzo" hidden aria-hidden="true" data-fichas-lienzo></canvas>
      <p class="contador" hidden aria-hidden="true" data-fichas-contador>{h.fichas} <span data-fichas-cuenta></span></p>
      <figcaption class="ejemplo">{h.ejemplo}</figcaption>
      <button class="pausa" type="button" hidden aria-pressed="false" aria-label={s.pause} title={s.pause} data-fichas-pausa data-pausar={s.pause} data-reanudar={s.resume}>
        <svg class="i-pausa" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="6" width="3.2" height="12" rx="1"></rect><rect x="13.8" y="6" width="3.2" height="12" rx="1"></rect></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
      </button>
    </figure>
  </div>
</section>

<style>
  .construye { background: var(--color-mist); padding-block: 96px; }
  .rejilla { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px 64px; align-items: center; }
  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .etiqueta { margin: 0; font: 500 13px/1.3 var(--font-mono); letter-spacing: 0.04em; color: var(--color-deep); }
  h2 { margin: 0; }
  .lead { margin: 0; font-size: 18px; color: var(--color-slate); }
  .puntos { margin: 0 0 8px; padding: 0; list-style: none; display: grid; gap: 10px; }
  .puntos li { position: relative; padding-left: 26px; font-size: 16px; color: var(--color-ink); }
  /* Cada punto lleva una ficha de 2 studs vista de frente, en cian. */
  .puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 14px;
    height: 9px;
    border-radius: 2px;
    background: var(--color-antidote);
    box-shadow: 3px -3px 0 -1px var(--color-antidote), 9px -3px 0 -1px var(--color-antidote);
  }

  /* El lienzo y la foto ocupan el mismo marco; la escena tiene fondo transparente sobre la bruma. */
  .escenario { position: relative; margin: 0; aspect-ratio: 5 / 4; }
  .poster, .lienzo { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .poster { object-fit: contain; transition: opacity var(--t-base) var(--ease-out); }
  .lienzo[hidden] { display: none; }

  .contador { position: absolute; left: 4px; top: 4px; margin: 0; font: 500 13px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--color-slate); font-variant-numeric: tabular-nums; }
  .contador span { color: var(--color-deep); }
  .contador[hidden] { display: none; }
  .ejemplo { position: absolute; left: 4px; bottom: 12px; padding: 4px 10px; border-radius: 999px; background: var(--color-paper); font: 500 12px/1.4 var(--font-mono); color: var(--color-slate); box-shadow: 0 1px 2px rgb(15 24 29 / 0.08); }

  .pausa { position: absolute; right: 0; bottom: 0; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--color-ink); opacity: 0.65; cursor: pointer; transition: opacity var(--t-fast) var(--ease-out); }
  .pausa:hover, .pausa:focus-visible { opacity: 1; }
  .pausa svg { width: 18px; height: 18px; fill: currentColor; }
  .pausa .i-play, .pausa[aria-pressed='true'] .i-pausa { display: none; }
  .pausa[aria-pressed='true'] .i-play { display: block; }
  .pausa[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .pausa { display: none; } }

  @media (max-width: 900px) {
    .construye { padding-block: 64px; }
    .rejilla { grid-template-columns: minmax(0, 1fr); }
    .lead { font-size: 17px; }
  }
</style>
