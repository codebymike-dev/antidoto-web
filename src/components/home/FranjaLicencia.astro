---
// Franja de la licencia en SST: el sello con la resolución y la entidad, los campos de acción
// que cubre y el enlace a /sg-sst/. Va justo después de la sala para que no quede enterrada.
import SelloLicencia from '../SelloLicencia.astro';
import { LICENCIA } from '../../data/site';
import { t, rutas, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const h = t(locale).inicio.equipo;
---
<section class="franja-licencia" aria-labelledby="licencia-t">
  <div class="wrap interior">
    <div class="cab">
      <h2 id="licencia-t">{h.licencia}</h2>
      <SelloLicencia locale={locale} />
    </div>
    <ul class="campos">
      {LICENCIA.campos[locale].map((c) => <li>{c}</li>)}
    </ul>
    <a class="ver" href={rutas.sgsst[locale]}>{h.licenciaVer}</a>
  </div>
</section>

<style>
  .franja-licencia { background: var(--color-paper); border-top: 1px solid var(--color-line-soft); }
  .interior { padding-block: 44px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 20px 40px; align-items: start; }
  .cab { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  h2 { margin: 0; font-size: clamp(26px, 1.4vw + 16px, 34px); line-height: 1.1; }
  .campos { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .campos li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: var(--color-mist); font-size: 14.5px; font-weight: 500; }
  .campos li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--color-antidote); flex: none; }
  .ver { grid-column: 2; justify-self: start; display: inline-flex; align-items: center; min-height: 44px; color: var(--color-deep); font-weight: 600; text-underline-offset: 3px; }
  .ver::after { content: '→'; margin-left: 0.4em; }
  .ver:hover { color: var(--color-ink); }
  @media (max-width: 860px) {
    .interior { grid-template-columns: 1fr; }
    .ver { grid-column: 1; }
  }
</style>
