---
import type { GetStaticPaths } from 'astro';
import Articulo from '../../../components/pages/Articulo.astro';
import { obtenerArticulos } from '../../../data/contenido';

export const getStaticPaths = (async () => (await obtenerArticulos()).map((articulo) => ({ params: { slug: articulo.pt.slug }, props: { articulo } }))) satisfies GetStaticPaths;

const { articulo } = Astro.props;
---
<Articulo locale="pt" articulo={articulo} />
