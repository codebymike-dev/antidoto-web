const variablesApi: Array<[string, string]> = [
  ['TURSO_DATABASE_URL y TURSO_AUTH_TOKEN', 'Base de datos.'],
  ['BLOB_READ_WRITE_TOKEN (o BLOB_STORE_ID)', 'Store privado de Blob para imágenes y archivos.'],
  ['APP_URL, ORIGENES, SITIO_URL', 'Dirección de la API, orígenes del sitio que pueden llamarla y dirección pública del sitio.'],
